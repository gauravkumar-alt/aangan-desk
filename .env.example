# ── Mode ────────────────────────────────────────────────────────────────────────
# true: demo controls on; with nothing else set, the app uses a built-in mock of the Vaani calls API,
# a demo webhook secret and an in-app designer inbox (all clearly labelled). Set false in production.
DEMO_MODE=true
APP_BASE_URL=                # https://your-deployment — used for links in Telegram messages
APP_PASSWORD=                # optional shared password for the dashboard

# ── Vaani ─────────────────────────────────────────────────────────────────────
VAANI_PROVIDER=vaanivoice    # vaanivoice (app.vaanivoice.ai) | vaaniyantra
VAANI_API_KEY=               # VaaniVoice: vaani_… (X-API-Key) · VaaniYantra: ck_live_…
VAANI_WEBHOOK_TOKEN=         # VaaniVoice: any long random string; put it in the webhook URL as ?token=…
VAANI_WEBHOOK_SECRET=        # VaaniYantra only: whsec_… signing secret
VAANI_API_BASE=              # default https://api.vaanivoice.ai (or https://vaaniyantra.com)

# ── Designer handoff ──────────────────────────────────────────────────────────
HANDOFF_CHANNEL=telegram     # telegram | email
TELEGRAM_BOT_TOKEN=          # from @BotFather
TELEGRAM_CHAT_ID=            # designers' group chat id (bot must be a member)
TELEGRAM_ESCALATION_CHAT_ID= # optional: studio head, for existing-client escalations
RESEND_API_KEY=              # only if HANDOFF_CHANNEL=email
HANDOFF_EMAIL_TO=
HANDOFF_EMAIL_FROM=

# ── CRM (optional) ─────────────────────────────────────────────────────────────
CRM_PROVIDER=zoho            # zoho | hubspot
# Zoho: api-console.zoho.in → Self Client → scopes
#   ZohoCRM.modules.leads.ALL,ZohoCRM.modules.contacts.ALL,ZohoCRM.modules.deals.ALL,ZohoCRM.modules.notes.ALL
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_DC=in                   # in (zoho.in) | com | eu | com.au …
ZOHO_DEAL_STAGE=             # default "Qualification"
# HubSpot alternative:
HUBSPOT_TOKEN=               # private app token (pat-…): crm.objects.contacts.read/write, crm.objects.deals.write
HUBSPOT_PIPELINE=            # default "default"
HUBSPOT_DEAL_STAGE=          # default "appointmentscheduled"

# ── Consultation booking ──────────────────────────────────────────────────────
CALENDLY_URL=                # e.g. https://calendly.com/you/consultation — handoff links here, pre-filled

# ── Storage ───────────────────────────────────────────────────────────────────
SUPABASE_URL=                # unset → local JSON file in ./data (demo only)
SUPABASE_SERVICE_ROLE_KEY=
DATA_DIR=                    # override the local file location

# ── Cron (Vercel) ─────────────────────────────────────────────────────────────
CRON_SECRET=                 # protects GET /api/handoffs/retry
